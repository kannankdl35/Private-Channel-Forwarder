# ---------------------------------------------------------------------------
# Telegram API credentials — from https://my.telegram.org (API Development Tools)
# ---------------------------------------------------------------------------
API_ID=123456
API_HASH=your_api_hash_here

# Telethon StringSession for the USER account that is a member of
# Source Channel A. Generate one with:
#   python scripts/generate_session.py
# NEVER commit this value or share it — it grants full access to the account.
SESSION_STRING=your_session_string_here

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
# Source channel to monitor (the user account must already be a member).
# Private channels have no @username, so use the numeric chat ID, e.g. -1001234567890.
# Not sure of the ID? Run: python scripts/list_channels.py
SOURCE_CHANNEL_ID=-1001111111111

# Destination channel to forward into (the account must be able to post there).
DEST_CHANNEL_ID=-1002222222222

# ---------------------------------------------------------------------------
# Optional behavior (safe defaults shown)
# ---------------------------------------------------------------------------

# Hide the "Forwarded from <Channel A>" attribution on messages in Channel B.
DROP_AUTHOR=false

# On the very first run only (when there is no saved state yet), forward the
# channel's existing backlog instead of starting from "new messages only".
FORWARD_EXISTING_ON_FIRST_RUN=false

# How many messages to fetch per page while catching up after downtime.
# Catch-up loops in pages of this size until fully caught up, so this is a
# batch size, not a hard cap on how far back it can recover.
CATCH_UP_LIMIT=500

# Max retry attempts for a failed forward before the service gives up on it
# and moves on (the message is logged as failed, not silently dropped).
MAX_RETRIES=5

# Small pause after each successful forward, to stay gentle on rate limits
# during large catch-up runs.
FORWARD_DELAY_SECONDS=0.3

# Seconds to buffer messages that belong to the same album (grouped media)
# before forwarding them together as one group.
ALBUM_FLUSH_DELAY=2.0

# Telethon's internal threshold (seconds) below which flood waits are
# handled automatically inside the library itself.
FLOOD_SLEEP_THRESHOLD=60

# ---------------------------------------------------------------------------
# Logging & storage
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/forwarder.log

# SQLite database used to track forwarded messages (dedupe) and resume
# position across restarts.
DB_PATH=data/forwarder.db
